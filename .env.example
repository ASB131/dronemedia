# Drone Media — copy to .env and edit before first start.
# Host volume paths can also be set here (see UPLOAD_LOCATION_*).

# --- Public URL (required) ---
# URL browsers use (LAN IP, hostname, or HTTPS domain).
PUBLIC_URL=http://127.0.0.1:3384

# --- Auth (required) ---
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TRUST_HOST=true

# --- Image tag (GHCR) ---
# Use "latest" after main publishes, or pin e.g. v1.0.0 / sha-abc1234
APP_VERSION=latest

# --- Host port for the web UI ---
HOST_PORT=3384

# --- Optional DB credentials (must match across services) ---
POSTGRES_USER=drone_media
POSTGRES_PASSWORD=drone_media
POSTGRES_DB=drone_media

# --- Host bind mounts (edit for your disks) ---
UPLOAD_LOCATION_POSTGRES=./data/postgres
UPLOAD_LOCATION_REDIS=./data/redis
UPLOAD_LOCATION_CACHE=./data/cache
UPLOAD_LOCATION_MEDIA=./data/media

# --- Optional ---
# CONFIG_FILE=./config.yml
# LOG_LEVEL=info
# APP_MEM_LIMIT=3g
# WORKER_MEM_LIMIT=6g
