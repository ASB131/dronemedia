# Drone Media environment overrides (secrets / non-Docker local runs).
# Host volume paths are set in docker-compose.yml — edit that file for binds.

# --- Server ---
HOST=0.0.0.0
# Container / process listen port (internal). Docker maps host 3384 -> 2283.
PORT=2283
# URL browsers use (host port or HTTPS domain). Required for Auth.js.
PUBLIC_URL=http://192.168.1.177:3384

# --- Auth.js (required for LAN/IP access) ---
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TRUST_HOST=true

# --- Database (local/dev connection string) ---
DATABASE_URL=postgresql://drone_media:drone_media@localhost:5432/drone_media

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Storage tiers for non-Docker runs (override config.yml paths) ---
APP_DATA_PATH=./data/app
CACHE_PATH=./data/cache
MEDIA_PATH=./data/media

# --- Config file location (defaults to ./config.yml) ---
CONFIG_PATH=./config.yml

# --- Logging ---
LOG_LEVEL=info

# --- Node ---
NODE_ENV=development
